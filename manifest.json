{
  "manifest_version": 3,
  "name": "YouTube Clean Player",
  "version": "1.0.8",
  "description": "Extensão pessoal para reduzir anúncios e promoções no YouTube.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "action": {
    "default_title": "YouTube Clean Player",
    "default_popup": "dist/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/page.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": [
        "src/styles/cosmetic.css"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
